 set +v;
 _mlshdbg=&apos;v&apos;
 ;;
 *x*)
 set +x;
 _mlshdbg=&apos;x&apos;
 ;;
 *)
 _mlshdbg=&apos;&apos;
 ;;
 esac;
 fi;
 unset _mlre _mlIFS;
 if [ -n &quot;${IFS+x}&quot; ]; then
 _mlIFS=$IFS;
 fi;
 IFS=&apos; &apos;;
 for _mlv in ${MODULES_RUN_QUARANTINE:-};
 do
 if [ &quot;${_mlv}&quot; = &quot;${_mlv##*[!A-Za-z0-9_]}&quot; -a &quot;${_mlv}&quot; = &quot;${_mlv#[0-9]}&quot; ]; then
