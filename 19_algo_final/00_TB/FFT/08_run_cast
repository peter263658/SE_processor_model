#!/usr/bin/env bash
# STFT(Q1.15)->e4m3 cast test: fxp_to_e4m3 vs model encoder-input e4m3 golden (k=9).
# Patterns from gen_cast_patterns.py (run that first if patterns/ is stale). Pass: "[TB] ALL PASS".
set -e
cd "$(dirname "$0")"

# (re)generate patterns from the golden if missing
if [ ! -f patterns/stft_cast_in.hex ] || [ ! -f patterns/stft_cast_golden.hex ]; then
    python3 gen_cast_patterns.py
fi

# CAD tools / license
export VCS_HOME=/usr/cad/synopsys/vcs/cur
export PATH=$VCS_HOME/bin:$VCS_HOME/linux/bin:/usr/cad/synopsys/verdi/cur/bin:$PATH
export LM_LICENSE_FILE=26585@lshc:26585@lstc:26585@lstn
export SNPSLMD_LICENSE_FILE=$LM_LICENSE_FILE

vcs -f cast_file.f -full64 -R +v2k +notimingcheck -sverilog -timescale=1ns/10ps -debug_access+all \
    -y /usr/cad/synopsys/synthesis/cur/dw/sim_ver +incdir+/usr/cad/synopsys/synthesis/cur/dw/sim_ver +libext+.v \
    2>&1 | tee cast_run.log

grep -q "\[TB\] ALL PASS" cast_run.log
echo "[08_run_cast] PASS"
