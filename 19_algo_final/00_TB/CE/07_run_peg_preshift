#!/usr/bin/env bash
# PEG i_preshift directed test — verifies preshift != 0 (the FP16-tree overflow fix):
#   PEG(preshift=s) == ldexp(PEG(preshift=0), s) in-band, + FTZ/saturating boundary.
# Pass: "[TB] ALL PASS".
set -e
cd "$(dirname "$0")"

# CAD tools / license (csh-only profiles don't reach bash)
export VCS_HOME=/usr/cad/synopsys/vcs/cur
export PATH=$VCS_HOME/bin:$VCS_HOME/linux/bin:/usr/cad/synopsys/verdi/cur/bin:$PATH
export LM_LICENSE_FILE=26585@lshc:26585@lstc:26585@lstn
export SNPSLMD_LICENSE_FILE=$LM_LICENSE_FILE

vcs -f peg_preshift_file.f -full64 -R +v2k +notimingcheck -sverilog -timescale=1ns/10ps -debug_access+all \
    -y /usr/cad/synopsys/synthesis/cur/dw/sim_ver +incdir+/usr/cad/synopsys/synthesis/cur/dw/sim_ver +libext+.v \
    2>&1 | tee peg_preshift_run.log

# belt-and-suspenders: $fatal(1) already exits non-zero, but also require the banner
grep -q "\[TB\] ALL PASS" peg_preshift_run.log
echo "[07_run_peg_preshift] PASS"
