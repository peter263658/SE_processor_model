#!/usr/bin/env bash
# e4m3 cast unit test — fp16_to_e4m3 RNE round-trip over all 254 finite e4m3 codes.
# DUT: ce_fp_util (fp16_to_e4m3). Pass: "[TB] ALL PASS, checked 254".
set -e
cd "$(dirname "$0")"

# CAD tools / license (csh-only profiles don't reach bash)
export VCS_HOME=/usr/cad/synopsys/vcs/cur
export PATH=$VCS_HOME/bin:$VCS_HOME/linux/bin:/usr/cad/synopsys/verdi/cur/bin:$PATH
export LM_LICENSE_FILE=26585@lshc:26585@lstc:26585@lstn
export SNPSLMD_LICENSE_FILE=$LM_LICENSE_FILE

vcs -f e4m3_file.f -full64 -R +v2k +notimingcheck -sverilog -timescale=1ns/10ps -debug_access+all \
    2>&1 | tee e4m3_run.log

# belt-and-suspenders: $fatal(1) already exits non-zero, but also require the banner
grep -q "\[TB\] ALL PASS" e4m3_run.log
echo "[07_run_e4m3] PASS"
