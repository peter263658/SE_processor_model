#!/usr/bin/env bash
# CE W4A8 per-layer GOLDEN sim — encoder.model.3.0.pointwise (sub-op 7, ic=32, oc=64).
# Full 32-wide FP16 saturating-tree reduction (vs enc0's single product). Compares CE_core.oacc_re
# against a BIT-EXACT fp16 golden (same paired tree + APoT dealer) derived from the REAL image +
# real act. Regenerate golden first if patterns changed:
#     python3 ../../10_algo/scripts/gen_golden_conv.py encoder.model.3.0.pointwise 7
set -e
cd "$(dirname "$0")"

export VCS_HOME=/usr/cad/synopsys/vcs/cur
export PATH=$VCS_HOME/bin:$VCS_HOME/linux/bin:/usr/cad/synopsys/verdi/cur/bin:$PATH
export LM_LICENSE_FILE=26585@lshc:26585@lstc:26585@lstn
export SNPSLMD_LICENSE_FILE=$LM_LICENSE_FILE

G=../../10_algo/hw_patterns_final/sram_images/golden/encoder_model_3_0_pointwise_r__0
if [ ! -f $G/golden_preBN_t0.hex ]; then
    echo "[13_run] golden missing -> generating"
    python3 ../../10_algo/scripts/gen_golden_conv.py encoder.model.3.0.pointwise 7
fi

vcs -f tb_ce_engine_golden_file.f -full64 -R +v2k +notimingcheck -sverilog -timescale=1ns/10ps -debug_access+all \
    -y /usr/cad/synopsys/synthesis/cur/dw/sim_ver +incdir+/usr/cad/synopsys/synthesis/cur/dw/sim_ver +libext+.v \
    +SUBOP=7 +IC=32 +OC=64 +ACT=$G/act_t0.hex +GOLD=$G/golden_preBN_t0.hex \
    2>&1 | tee ce_engine_golden_enc3_run.log

echo "[13_run_ce_engine_golden_enc3] sim done — see table above (per-oc OACC vs bit-exact golden)."
