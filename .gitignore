# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.env

# Regenerable caches (e.g. dataset file-list caches)
.cache/

# Model checkpoints & weights (通常很大)
*.pth
*.pt
*.ckpt
*.h5
*.pkl

# Dataset (建議不要放進去)
data/
datasets/
Dataset/

# Large archives & external tools
*.tar.gz
ollama/
weights/

# Training outputs, checkpoints & logs
outputs/
checkpoints/
logs/
lightning_logs/
wandb/
mlruns/
results/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Archives / installers / external tool binaries (regenerable; some exceed GitHub's 100 MB limit)
*.tar
*.AppImage
Miniforge3.sh
tools/

# Raw speech dataset
speech/

# Run logs
*.log

# VCS / Verdi simulation build products (regenerated by the 00_TB run_* scripts)
csrc/
*.daidir/
simv
ucli.key
*.fsdb
*.vpd
*.vcd
verdiLog/
novas.*

# Backup copies and sweep marker files
*.bak
*_bak
*_DONE

# Local Claude Code settings
.claude/settings.local.json

# Third-party reference papers
*.pdf
